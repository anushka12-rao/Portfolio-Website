# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio-cms

# Session Secret (change to a random 32+ character string in production)
SESSION_SECRET=portfolio_super_secure_session_secret_key_random_32_chars

# Admin Seeder Defaults
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=Admin@123456

# Cloudinary (Optional - local fallback storage is used if left blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
